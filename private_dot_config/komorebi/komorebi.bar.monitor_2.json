{
	"$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.bar.json",
	"height": 50,
	"font_family": "Segoe UI",
	"font_size": 18,
	"max_label_width": 350,
	"icon_scale": 1,
	"widget_spacing": 25,
	"transparency_alpha": 255,
	"monitor": {
		"index": 1,
		"work_area_offset": {
			"left": 0,
			"top": 45,
			"right": 0,
			"bottom": 40
		}
	},
	"left_widgets": [
		{
			"Komorebi": {
				"workspaces": {
					"enable": true,
					"hide_empty_workspaces": false,
					"display": "AllIconsAndText"
				},
				"layout": {
					"enable": true
				}
			}
		}
	],
	"center_widgets": [
		{
			"Media": {
				"enable": true,
				"display": "IconAndControls"
			}
		}
	],
	"right_widgets": [
		{
			"Update": {
				"enable": true
			}
		},
		{
			"Time": {
				"enable": true,
				"format": {
					"Custom": "%l:%M %p"
				}
			}
		},
		{
			"Date": {
				"enable": true,
				"format": {
					"Custom": "%A, %B %e, %Y"
				}
			}
		},
		{
			"Battery": {
				"enable": true
			}
		},
		{
			"Systray": {
				"enable": true,
				"hidden_icons": [
					"XRiteColorAssistant.exe",
					"kdeconnect-indicator.exe",
					"Spark Desktop.exe",
					"nextcloud.exe",
					"SecurityHealthSystray.exe",
					{
						"guid": "6da68f06-00f1-4e6e-8158-7f1ffd4f9db9"
					},
					{
						"tooltip": "X-Mouse Button Control v2.20.5"
					},
					{
						"guid": "7820ae78-23e3-4229-82c1-e41cb67d5b9c"
					}
				]
			}
		}
	]
}
