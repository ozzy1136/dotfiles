{
	"$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
	"version": 4,
	"upgrade": {
		"notice": true
	},
	"final_space": true,
	"palette": {
		"bg": "#100f0f",
		"bg-2": "#1c1b1a",
		"tx-3": "#575653",
		"tx-2": "#878580",
		"tx": "#cecdc3",
		"re": "#d14d41",
		"or": "#da702c",
		"ye": "#d0a215",
		"gr": "#879a39",
		"cy": "#3aa99f",
		"bl": "#4385be",
		"pu": "#8b7ec8",
		"ma": "#ce5d97"
	},
	"secondary_prompt": {
		"background": "transparent",
		"template": " "
	},
	"valid_line": {
		"background": "transparent",
		"template": "> "
	},
	"error_line": {
		"background": "transparent",
		"template": "<p:re>\uea87</> "
	},
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"leading_diamond": "<p:bl>\u250f</>",
			"segments": [
				{
					"type": "os",
					"style": "diamond",
					"foreground": "p:tx",
					"template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}}"
				},
				{
					"type": "session",
					"style": "plain",
					"template": "[<p:tx>\ueb99</> {{ .UserName }} @ <p:tx>\uf108</> {{ .HostName }}]",
					"foreground": "p:ye"
				},
				{
					"type": "time",
					"style": "plain",
					"template": "[<p:tx>\uf073</> {{ .CurrentDate | date .Format }}]",
					"foreground": "p:pu",
					"options": {
						"time_format": "Monday, January 2, 2006 at 3:04 PM"
					}
				},
				{
					"type": "sysinfo",
					"style": "plain",
					"template": "[<p:tx>\ue266</> RAM: {{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB]",
					"foreground": "p:cy"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "left",
			"newline": true,
			"leading_diamond": "<p:bl>\u2523</>",
			"segments": [
				{
					"type": "path",
					"style": "diamond",
					"template": "[<p:tx>\uf115</> {{ .Path }}]",
					"options": {
						"style": "full"
					},
					"foreground": "p:gr"
				},
				{
					"type": "git",
					"style": "plain",
					"template": "[<p:tx>{{ .UpstreamIcon }} </>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <p:tx>\uf044</> {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} <p:tx>\uf046</> {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} <p:tx>\ueb4b</> {{ .StashCount }}{{ end }}]",
					"options": {
						"fetch_status": true,
						"fetch_upstream_icon": true
					},
					"foreground": "p:ma"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "left",
			"newline": true,
			"leading_diamond": "<p:bl>\u2514\u2500</>",
			"segments": [
				{
					"style": "diamond",
					"template": "<p:tx>[#]</>",
					"type": "root"
				},
				{
					"foreground": "p:re",
					"style": "diamond",
					"template": "[<p:tx>\uea6c</> Error, check your command]",
					"type": "status"
				},
				{
					"style": "diamond",
					"template": ">",
					"type": "text"
				}
			]
		}
	]
}
